---
import AuthStatus from "./auth/AuthStatus.svelte";
---
<footer class="border-t border-slate-700 mt-8 py-6 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900">
  <div class="max-w-6xl w-full mx-auto px-4 flex flex-col sm:flex-row justify-between items-center text-sm">
    <div class="text-slate-400">© 2025 Awadhi New</div>
    <div class="mt-2 sm:mt-0">
      <!-- show role (client-only) with distinct styling -->
      <AuthStatus minimal={true} client:load />
    </div>
  </div>
</footer>
