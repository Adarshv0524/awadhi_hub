---
type UserRole = "guest" | "registered" | "moderator" | "senior_moderator" | "admin";

const minRole: UserRole = (Astro.props.minRole ?? "registered") as UserRole;
const apiBase: string = Astro.props.apiBase || (import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : ""));

---

<script is:inline define:vars={{ apiBase, minRole }}>
	(async function () {
		function loginRedirectUrl() {
			const path = `${window.location.pathname || "/"}${window.location.search || ""}`;
			return `/login?next=${encodeURIComponent(path)}`;
		}

		function emitAuthPolicy(eventName, decision, reason, statusCode, details) {
			const payload = {
				event_name: eventName,
				route: window.location.pathname,
				min_role: minRole,
				decision,
				reason,
				status_code: statusCode ?? null,
				details: details || {},
			};

			try {
				const body = JSON.stringify(payload);
				if (navigator.sendBeacon) {
					const blob = new Blob([body], { type: "application/json" });
					navigator.sendBeacon(`${apiBase}/api/v1/telemetry/auth-policy`, blob);
					return;
				}
				void fetch(`${apiBase}/api/v1/telemetry/auth-policy`, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body,
					keepalive: true,
				}).catch(() => undefined);
			} catch (_) {}
		}

		try {
			if (typeof window === "undefined") return;
			const token = window.localStorage.getItem("awadhi_access_token");
			if (!token) {
				emitAuthPolicy("auth_guard_decision", "deny", "missing_token", 401, { has_token: false });
				window.location.href = loginRedirectUrl();
				return;
			}

			if (!apiBase) {
				// No API base configured; safest behavior is to force login.
				emitAuthPolicy("auth_guard_decision", "deny", "missing_api_base", null, { has_token: true });
				window.location.href = loginRedirectUrl();
				return;
			}

			const res = await fetch(`${apiBase}/auth/me`, {
				headers: { Authorization: `Bearer ${token}` },
			});

			if (!res.ok) {
				emitAuthPolicy("auth_guard_decision", "deny", "me_request_failed", res.status, { has_token: true });
				window.localStorage.removeItem("awadhi_access_token");
				window.localStorage.removeItem("awadhi_refresh_token");
				window.localStorage.removeItem("awadhi_user_cache");
				window.location.href = loginRedirectUrl();
				return;
			}

			const me = await res.json().catch(() => null);
			if (me) {
				window.localStorage.setItem("awadhi_user_cache", JSON.stringify(me));
				window.__awadhiAuthGuardMe = me;
			}
			const role = me?.role;
			const ranks = { guest: 0, registered: 1, moderator: 2, senior_moderator: 3, admin: 4 };
			const ok = role && ranks[role] >= ranks[minRole];
			if (!ok) {
				emitAuthPolicy("auth_guard_decision", "deny", "insufficient_role", 403, { role: role || null });
				window.location.href = "/";
				return;
			}
			emitAuthPolicy("auth_guard_decision", "allow", "role_satisfied", 200, { role });
		} catch (_) {
			emitAuthPolicy("auth_guard_decision", "error", "guard_exception", null, {});
			// Non-blocking; if the admin page loads without data, tables will show 401/403.
		}
	})();
</script>

