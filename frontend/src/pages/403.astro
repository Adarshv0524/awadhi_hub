---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Access Denied · Awadhi New" noindex>
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="max-w-2xl w-full text-center">
      <!-- Error Code -->
      <div class="mb-8">
        <h1 class="text-9xl font-bold bg-gradient-to-r from-red-400 via-orange-400 to-yellow-400 bg-clip-text text-transparent">
          403
        </h1>
        <div class="text-2xl font-serif text-slate-300 mt-4">Access Denied</div>
      </div>

      <!-- Message -->
      <div class="mb-8 p-6 bg-slate-800 border border-slate-700 rounded-lg">
        <p class="text-slate-400 text-lg mb-3">
          You don't have permission to access this resource.
        </p>
        <p class="text-slate-500 text-sm">
          This page is restricted to authorized users only.
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="space-y-4">
        <div class="text-sm text-slate-500 mb-4">What you can do:</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href="/login"
            class="px-6 py-3 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-500 hover:to-red-500 text-white rounded-lg transition-all font-medium shadow-lg"
          >
            🔐 Login
          </a>
          <a
            href="/"
            class="px-6 py-3 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 rounded-lg transition-colors font-medium"
          >
            🏠 Go Home
          </a>
        </div>
      </div>

      <!-- Help Text -->
      <div class="mt-8 p-4 bg-yellow-900/20 border border-yellow-700/50 rounded-lg">
        <p class="text-sm text-yellow-200/80">
          💡 If you believe you should have access, please check your account permissions or contact an administrator.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
