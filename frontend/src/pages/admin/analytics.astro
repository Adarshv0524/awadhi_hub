---
// src/pages/admin/analytics.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import AuthGuard from "../../components/auth/AuthGuard.astro";

import AnalyticsTop from "../../components/admin/AnalyticsTop.svelte";
import AnalyticsGrowth from "../../components/admin/AnalyticsGrowth.svelte";
import AnalyticsDemand from "../../components/admin/AnalyticsDemand.svelte";
import AnalyticsStats from "../../components/admin/AnalyticsStats.svelte";
import SystemInfo from "../../components/admin/SystemInfo.svelte";

export const prerender = false;
const API_BASE = import.meta.env.PUBLIC_API_BASE ?? "";
---
<AdminLayout title="Analytics · Admin">
  <!-- Client-side guard: will redirect if not logged in or low role -->
  <AuthGuard apiBase={API_BASE} minRole="admin" client:load />

  <div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-serif font-bold bg-gradient-to-r from-purple-400 via-pink-400 to-indigo-400 bg-clip-text text-transparent">
          Analytics Dashboard
        </h1>
        <p class="text-slate-400 mt-2">Platform performance, engagement metrics, and growth trends</p>
      </div>
      <div class="flex gap-2">
        <a
          href="/admin/audit"
          class="px-4 py-2 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 rounded text-sm transition-colors flex items-center gap-2"
        >
          📋 Audit Logs
        </a>
        <a
          href="/admin"
          class="px-4 py-2 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 rounded text-sm transition-colors flex items-center gap-2"
        >
          ← Back to Admin
        </a>
      </div>
    </div>

    <!-- Platform Statistics Overview -->
    <div class="mb-8">
      <AnalyticsStats apiBase={API_BASE} client:load />
    </div>

    <!-- Main Analytics Grid -->
    <div class="space-y-6">
      <!-- Row 1: Top Content + Demand Distribution -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Top Content - Takes 2 columns -->
        <section class="lg:col-span-2 bg-slate-800 border border-slate-700 rounded-lg p-6 shadow-lg">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-cyan-400 flex items-center gap-2">
              🏆 Top Performing Content
            </h2>
          </div>
          <AnalyticsTop apiBase={API_BASE} client:load />
        </section>

        <!-- Demand Distribution - Takes 1 column -->
        <section class="bg-slate-800 border border-slate-700 rounded-lg p-6 shadow-lg">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-indigo-400 flex items-center gap-2">
              🔍 Search Demand
            </h2>
          </div>
          <AnalyticsDemand apiBase={API_BASE} client:load />
        </section>
      </div>

      <!-- Row 2: Growth Trends - Full width -->
      <section class="bg-slate-800 border border-slate-700 rounded-lg p-6 shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-blue-400 flex items-center gap-2">
            📈 Growth Trends (Last 30 Days)
          </h2>
        </div>
        <AnalyticsGrowth apiBase={API_BASE} client:load />
      </section>

      <!-- Row 3: System Info - Full width -->
      <section>
        <SystemInfo client:load />
      </section>
    </div>
  </div>
</AdminLayout>
