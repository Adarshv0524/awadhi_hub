---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModerationQueue from "../../components/moderation/ModerationQueue.svelte";

export const prerender = false;
---

<BaseLayout title="Moderation · Awadhi New">
  <head>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <div class="max-w-6xl mx-auto py-6">
    <h1 class="text-2xl font-serif mb-4">Moderation Queue</h1>
    <!-- client:load ensures the Svelte component runs in the browser (needs auth token) -->
    <ModerationQueue client:load />
  </div>
</BaseLayout>
