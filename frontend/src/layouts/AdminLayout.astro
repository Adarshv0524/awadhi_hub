---
// src/layouts/AdminLayout.astro
import "../styles/global.css";
import AuthGuard from "../components/auth/AuthGuard.astro";

const title = Astro.props.title ?? "Admin · Awadhi New";
const API_BASE = import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : "");
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body class="admin-root">
    <a href="#admin-main-content" class="admin-skip-link">Skip to main content</a>
    <AuthGuard minRole="admin" apiBase={API_BASE} />

    <div class="admin-shell">
      <!-- Sidebar Navigation -->
      <aside class="admin-sidebar-panel">
        <div class="admin-brand-block">
          <a href="/" class="admin-brand-link">Awadhi New</a>
          <div class="admin-brand-meta">Admin Console</div>
        </div>
        
        <nav aria-label="Admin navigation" class="admin-nav">
          <a href="/admin" class="admin-nav-link" data-active={currentPath === '/admin'}>
            <span class="text-lg mr-2">📊</span> Dashboard
          </a>
          <a href="/admin/users" class="admin-nav-link" data-active={currentPath === '/admin/users'}>
            <span class="text-lg mr-2">👥</span> Users
          </a>
          <a href="/admin/hierarchy" class="admin-nav-link" data-active={currentPath === '/admin/hierarchy'}>
            <span class="text-lg mr-2">📚</span> Hierarchy
          </a>
          <a href="/admin/settings" class="admin-nav-link" data-active={currentPath === '/admin/settings'}>
            <span class="text-lg mr-2">⚙️</span> Settings
          </a>
          <a href="/admin/audit" class="admin-nav-link" data-active={currentPath === '/admin/audit'}>
            <span class="text-lg mr-2">📝</span> Audit Logs
          </a>
          
          <div class="admin-nav-secondary">
            <a href="/moderation" class="admin-nav-link">
              <span class="text-lg mr-2">✅</span> Moderation
            </a>
            <a href="/" class="admin-nav-link">
              <span class="text-lg mr-2">🏠</span> Public Site
            </a>
          </div>
        </nav>
      </aside>

      <!-- Main Content Area -->
      <div class="admin-content-shell">
        <header class="admin-topbar">
          <h1 class="admin-topbar-title">{title.replace(' · Admin', '')}</h1>
          <div class="admin-topbar-actions">
            <button id="admin-mobile-nav-toggle" class="admin-mobile-nav-toggle" aria-expanded="false" aria-controls="admin-mobile-nav">
              Menu
            </button>
            <div class="admin-user-pill">
              <span id="admin-username">Loading...</span>
            </div>
          </div>
        </header>

        <nav id="admin-mobile-nav" class="admin-mobile-nav" aria-label="Admin mobile navigation" hidden>
          <a href="/admin" class="admin-nav-link" data-active={currentPath === '/admin'}>Dashboard</a>
          <a href="/admin/users" class="admin-nav-link" data-active={currentPath === '/admin/users'}>Users</a>
          <a href="/admin/hierarchy" class="admin-nav-link" data-active={currentPath === '/admin/hierarchy'}>Hierarchy</a>
          <a href="/admin/settings" class="admin-nav-link" data-active={currentPath === '/admin/settings'}>Settings</a>
          <a href="/admin/audit" class="admin-nav-link" data-active={currentPath === '/admin/audit'}>Audit Logs</a>
          <a href="/admin/analytics" class="admin-nav-link" data-active={currentPath === '/admin/analytics'}>Analytics</a>
          <a href="/moderation" class="admin-nav-link">Moderation</a>
          <a href="/" class="admin-nav-link">Public Site</a>
        </nav>

        <main id="admin-main-content" class="admin-main flex-1">
          <slot />
        </main>

        <footer class="admin-footer">
          © {new Date().getFullYear()} Awadhi New — Admin Console
        </footer>
      </div>
    </div>

    <script is:inline>
      (async function() {
        const toggle = document.getElementById("admin-mobile-nav-toggle");
        const mobileNav = document.getElementById("admin-mobile-nav");
        if (toggle && mobileNav) {
          const setOpen = function (open) {
            toggle.setAttribute("aria-expanded", String(open));
            mobileNav.hidden = !open;
          };
          toggle.addEventListener("click", function () {
            const expanded = toggle.getAttribute("aria-expanded") === "true";
            setOpen(!expanded);
          });
          mobileNav.addEventListener("click", function (event) {
            const target = event.target;
            if (target instanceof HTMLElement && target.closest("a")) {
              setOpen(false);
            }
          });
          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") setOpen(false);
          });
        }

        try {
          const el = document.getElementById("admin-username");
          if (!el) return;

          const applyUser = function (user) {
            if (!user) return;
            el.textContent = user.name || user.username || user.email || "admin";
          };

          if (window.__awadhiAuthGuardMe) {
            applyUser(window.__awadhiAuthGuardMe);
            return;
          }

          const cached = localStorage.getItem("awadhi_user_cache");
          if (cached) {
            applyUser(JSON.parse(cached));
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
