# Frontend Environment Variables Template
# Copy this to .env and fill in your values

# API Base URL - Backend API endpoint
PUBLIC_API_BASE=http://localhost:8000

# Site URL for SEO (canonical URLs, sitemaps, etc.)
# SITE=https://awadhi.new

# Frontend public URL (must match backend FRONTEND_BASE_URL for OAuth and reset-password redirects)
PUBLIC_FRONTEND_BASE_URL=http://localhost:4321

# Optional: backend Google client id mirror for debugging UI/config checks.
# OAuth flow itself is initiated by backend /auth/oauth/google/login.
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
