---
// src/pages/users/[username].astro
// Public user profile - SEO-indexable
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { api, ApiError } from "../../lib/api";
import UserStats from "../../components/user/UserStats.svelte";

const { username } = Astro.params;

// Check if viewing own profile
const currentUser = Astro.locals.user; // From auth middleware
const isOwnProfile = currentUser && currentUser.username === username;

let user: any = null;
let error: string | null = null;

try {
  user = await api(`/users/${username}`);
} catch (e) {
  if (e instanceof ApiError && e.status === 404) {
    error = "User not found";
  } else {
    error = "Failed to load user profile";
  }
  if (import.meta.env.DEV) {
    console.error("[User Profile] Error:", e);
  }
}

// Dummy stats implementation (TODO: Backend API needed)
// GitHub Issue: Add GET /users/:username/stats endpoint
// Should return: { public_submissions: number, approved_count: number, likes_received: number }
const dummyStats = {
  public_submissions: 0,  // Count of approved public submissions
  approved_count: 0,      // Count of approved content
  likes_received: 0       // Total likes on user's approved content
};

// SEO metadata
const title = user ? `${user.username} · Awadhi New` : `User ${username} · Awadhi New`;
const description = user 
  ? `View ${user.username}'s public profile on Awadhi New. Role: ${user.role}. Member since ${new Date(user.created_at).getFullYear()}.`
  : `User profile for ${username}`;
---

<BaseLayout title={title}>
  <head>
    <!-- ✅ SEO-indexable: Public profiles are crawlable -->
    <link rel="canonical" href={`https://awadhi.new/users/${username}`} />
    <meta name="description" content={description} />
  </head>

  <div class="max-w-4xl mx-auto px-4 py-8">
    {error ? (
      <div class="text-center py-12">
        <div class="bg-red-950 border border-red-800 rounded-lg p-8 inline-block">
          <p class="text-red-300 text-lg font-semibold mb-4">{error}</p>
          <a href="/authors" class="text-cyan-400 hover:text-cyan-300 underline">
            Browse Authors
          </a>
        </div>
      </div>
    ) : user && (
      <article class="space-y-8">
        <!-- User Header -->
        <div class="bg-gradient-to-br from-slate-800 via-slate-800 to-slate-900 border border-slate-700 rounded-lg p-8 text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-cyan-500 to-blue-500 mb-4">
            <span class="text-3xl font-bold text-white">
              {user.username.charAt(0).toUpperCase()}
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl font-serif font-bold mb-3 bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">
            {user.username}
          </h1>
          
          <div class="flex justify-center items-center gap-2 mb-4">
            <span 
              class="px-4 py-2 rounded-lg font-semibold text-sm uppercase tracking-wide"
              class:list={[
                user.role === 'admin' && 'bg-red-900/50 text-red-200 border border-red-700',
                user.role === 'moderator' && 'bg-purple-900/50 text-purple-200 border border-purple-700',
                user.role === 'contributor' && 'bg-blue-900/50 text-blue-200 border border-blue-700',
                user.role === 'registered' && 'bg-slate-700/50 text-slate-200 border border-slate-600'
              ]}
            >
              {user.role}
            </span>
          </div>
          
          {user.created_at && (
            <p class="text-slate-400 text-sm">
              <span class="text-slate-500">Member since</span>{' '}
              <time datetime={user.created_at} class="font-medium text-slate-300">
                {new Date(user.created_at).toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long'
                })}
              </time>
            </p>
          )}
        </div>

        <!-- Public Statistics -->
        <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
          <h2 class="text-xl font-semibold text-cyan-400 mb-6 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            Public Contributions
          </h2>
          
          <UserStats client:load username={user.username} isOwnProfile={isOwnProfile} />
          
          <!-- Note about stats -->
          <div class="mt-6 p-4 bg-blue-900/20 border border-blue-800/30 rounded-lg">
            <p class="text-xs text-blue-300 flex items-start gap-2">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Statistics show only approved and publicly visible content. Draft submissions and moderation data are kept private.</span>
            </p>
          </div>
        </div>

        <!-- Profile Information -->
        <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
          <h2 class="text-xl font-semibold text-blue-400 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Profile Details
          </h2>
          
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex flex-col">
              <dt class="text-xs uppercase tracking-wide text-slate-500 mb-1.5">Username</dt>
              <dd class="text-slate-200 font-medium text-lg">{user.username}</dd>
            </div>
            
            <div class="flex flex-col">
              <dt class="text-xs uppercase tracking-wide text-slate-500 mb-1.5">Role</dt>
              <dd class="text-slate-200 font-medium text-lg capitalize">{user.role}</dd>
            </div>
            
            {user.created_at && (
              <div class="flex flex-col">
                <dt class="text-xs uppercase tracking-wide text-slate-500 mb-1.5">Joined</dt>
                <dd class="text-slate-200 font-medium">
                  <time datetime={user.created_at}>
                    {new Date(user.created_at).toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'long', 
                      day: 'numeric' 
                    })}
                  </time>
                </dd>
              </div>
            )}
            
            <div class="flex flex-col">
              <dt class="text-xs uppercase tracking-wide text-slate-500 mb-1.5">Profile Type</dt>
              <dd class="text-slate-200 font-medium">Public</dd>
            </div>
          </dl>
        </div>

        <!-- Privacy Notice -->
        <div class="bg-slate-800/30 border border-slate-700/50 rounded-lg p-6">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-green-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            <div>
              <h3 class="text-sm font-semibold text-slate-200 mb-1">Privacy Protected</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                This is a public profile page. Only approved, publicly visible content is shown. 
                Private information such as email addresses, draft submissions, and moderation history are never displayed.
              </p>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex justify-center gap-4 pt-4">
          <a href="/authors" class="px-6 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg transition-all font-medium">
            Browse Authors
          </a>
          <a href="/" class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white rounded-lg transition-all font-medium">
            Back to Home
          </a>
        </div>
      </article>
    )}
  </div>
</BaseLayout>
