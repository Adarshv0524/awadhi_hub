---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModerationQueue from "../../components/moderation/ModerationQueue.svelte";
import SummaryKpiCards from "../../components/admin/SummaryKpiCards.svelte";

export const prerender = false;
---

<BaseLayout title="Moderation · Awadhi New">
  <head>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <div class="max-w-7xl mx-auto py-6">
    <div class="mb-5">
      <SummaryKpiCards title="Moderation KPI Snapshot" client:load />
    </div>
    <!-- client:load ensures the Svelte component runs in the browser (needs auth token) -->
    <ModerationQueue client:load />
  </div>
</BaseLayout>
