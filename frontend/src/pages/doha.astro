---
import BaseLayout from "../layouts/BaseLayout.astro";
import { api } from "../lib/api";
import EmptyState from "../components/EmptyState.svelte";

type DohaListItem = {
  id: number;
  title?: string;
  main_text?: string;
  slug?: string;
  meaning?: string;
  author_id?: number;
  author_name?: string;
  work_id?: number;
  work_name?: string;
  chapter_id?: number;
  chapter_name?: string;
  number_in_chapter?: number;
  status?: string;
  visibility?: string;
  views_count?: number;
  likes_count?: number;
  created_at?: string;
};

let items: DohaListItem[] = [];
let error: string | null = null;

try {
  items = await api<DohaListItem[]>("/content/doha");
} catch (e) {
  error = "Unable to load doha list.";
  if (import.meta.env.DEV) console.error("doha list error:", e);
}
---

<BaseLayout
  title="Doha · Awadhi New"
  description="Read Awadhi dohas with meanings, authorship context, and chapter-level organization in a searchable public archive."
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-serif mb-6 text-slate-100">Doha Collection</h1>

    {error && (
      <div class="bg-red-900/20 border border-red-700 rounded-lg p-4 text-red-400">
        <p class="font-semibold">Error Loading Dohas</p>
        <p class="text-sm mt-1">{error}</p>
      </div>
    )}

    {/* ✅ DEFENSIVE: Empty state when no results */}
    {!error && items.length === 0 && (
      <EmptyState
        client:load
        icon="📜"
        title="No dohas available yet"
        description="Check back soon for new content, or contribute your own!"
        actionText="Submit a Doha"
        actionHref="/submit"
      />
    )}

    {!error && items.length > 0 && (
      <ul class="space-y-4">
        {items.map((it) => (
          <li class="bg-slate-800 rounded-lg p-4 hover:bg-slate-700 transition-colors">
            <a href={`/doha/${it.id}`} class="block">
              {/* ✅ DEFENSIVE: Truncate long text */}
              <h2 class="text-lg font-medium text-slate-100 mb-2 line-clamp-2 break-words">
                {it.title ?? it.main_text ?? `Doha ${it.id}`}
              </h2>

              {(it.author_name || it.work_name || it.chapter_name || it.number_in_chapter) && (
                <p class="text-xs text-slate-400 mb-2 line-clamp-1 break-words">
                  {it.author_name || (it.author_id ? `Author #${it.author_id}` : "Unknown Author")}
                  {it.work_name && ` · ${it.work_name}`}
                  {it.chapter_name && ` · ${it.chapter_name}`}
                  {typeof it.number_in_chapter === "number" && ` · #${it.number_in_chapter}`}
                </p>
              )}

              {it.meaning && (
                <p class="text-sm text-slate-400 line-clamp-2 break-words">
                  {it.meaning}
                </p>
              )}

              <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-slate-400">
                <span>❤ {it.likes_count ?? 0}</span>
                <span>👁 {it.views_count ?? 0}</span>
                {it.status && <span class="uppercase tracking-wide">{it.status}</span>}
                {it.visibility && <span class="uppercase tracking-wide">{it.visibility}</span>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  /* Text truncation for overflow prevention */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .break-words {
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
</style>