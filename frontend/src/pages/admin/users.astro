---
// src/pages/admin/users.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import UsersTable from "../../components/admin/UsersTable.svelte";

export const prerender = false;
const API_BASE = import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : "");
---
<AdminLayout title="Users · Admin">
  <h1 class="text-2xl font-serif mb-4">Users</h1>
  <p class="mb-4 text-sm text-slate-300">
    Manage user roles, account state, and permission settings. Use search and filters to quickly find specific accounts.
  </p>
  <UsersTable apiBase={API_BASE} client:load />
</AdminLayout>
