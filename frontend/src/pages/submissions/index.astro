---
// src/pages/submissions/index.astro
// ✅ SSR-safe: No server-side API calls, all data fetching happens client-side
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import SubmissionsClient from "../../components/dashboard/SubmissionsClient.svelte";
---

<BaseLayout title="My Submissions · Awadhi New" noindex>
  <div class="min-h-screen bg-slate-900 py-8">
    <!-- ✅ Client-only: API calls happen in browser with localStorage token -->
    <SubmissionsClient client:only="svelte" />
  </div>
</BaseLayout>
