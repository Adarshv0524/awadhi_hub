---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { api } from "../../../lib/api";
import PoetryChapterReader from "../../../components/content/poetry/PoetryChapterReader.svelte";
import StructuredData from "../../../components/StructuredData.astro";
import "../../../styles/chapter.css";

/**
 * Chapter page:
 * - Uses poetry stream endpoint: /api/v1/poetry/chapters/{chapter_id}/stream
 * - Renders mixed poetry forms in chapter sequence through a dispatcher
 */

const params = Astro.params ?? {};
const author = params.author ?? null;
const work = params.work ?? null;
const chapter = params.chapter ?? null;

// Basic param validation
if (!author || !work || !chapter) {
  if (import.meta.env.DEV) console.error("[Chapter] Missing params:", { author, work, chapter });
  return Astro.redirect("/404");
}

const safeDecode = (s: any) => {
  try { return s ? decodeURIComponent(String(s)) : ""; }
  catch (e) { return String(s ?? ""); }
};
const displayTitle = (() => (safeDecode(chapter) || "").replace(/-/g, " "));
const encodedPath = [author, work, chapter].map((p) => encodeURIComponent(String(p))).join("/");
const baseUrl = (import.meta.env.SITE || "https://awadhi.new").replace(/\/$/, "");
const chapterUrl = `${baseUrl}/${encodedPath}`;

let chapterItems: any[] = [];
let total = 0;
let pageError = null;
let isEmptyChapter = false;
let chapterId: number | null = null;
let streamHierarchy: any = null;
const SSR_STREAM_LIMIT = 25;

const authorName = safeDecode(author).replace(/-/g, " ");
const workName = safeDecode(work).replace(/-/g, " ");

// Server-side fetch flow
try {
  const chapters = await api<any[]>(`/authors/${encodeURIComponent(author)}/works/${encodeURIComponent(work)}/chapters?offset=0&limit=500`);
  const currentChapter = Array.isArray(chapters)
    ? chapters.find((item: any) => String(item?.slug) === String(chapter))
    : null;

  if (!currentChapter?.id) {
    pageError = "Chapter not found in hierarchy.";
  } else {
    chapterId = Number(currentChapter.id);
    const stream = await api<any>(`/api/v1/poetry/chapters/${chapterId}/stream?offset=0&limit=${SSR_STREAM_LIMIT}`);
    chapterItems = Array.isArray(stream?.items) ? stream.items : [];
    total = Number(stream?.total ?? chapterItems.length);
    streamHierarchy = stream?.hierarchy || null;
  }

  isEmptyChapter = chapterItems.length === 0;
} catch (err) {
  console.error("[Chapter] Unexpected error:", err);
  pageError = "Unexpected error while loading chapter.";
}

const contentPreview = chapterItems
  .slice(0, 3)
  .map((item: any) => String(item?.main_text || "").replace(/\s+/g, " ").trim())
  .filter(Boolean)
  .join(" ");
const chapterDescription = contentPreview
  ? `${contentPreview.slice(0, 180)}${contentPreview.length > 180 ? "..." : ""}`
  : `${displayTitle || "Chapter"} from ${workName} by ${authorName} on Awadhi New.`;
const chapterKeywords = ["Awadhi chapter", authorName, workName, displayTitle, "Awadhi poetry"].filter(Boolean);
---

<BaseLayout
  title={`${streamHierarchy?.chapter?.title || displayTitle || "Chapter"} · ${streamHierarchy?.work?.title || workName} · Awadhi New`}
  description={chapterDescription}
  canonicalURL={chapterUrl}
  type="article"
  lang="hi"
  locale="hi_IN"
  keywords={chapterKeywords}
>
  <head>
    <StructuredData
      type="BreadcrumbList"
      data={{
        items: [
          { name: "Home", url: baseUrl },
          { name: streamHierarchy?.author?.name || authorName, url: `${baseUrl}/${encodeURIComponent(author)}` },
          { name: streamHierarchy?.work?.title || workName, url: `${baseUrl}/${encodeURIComponent(author)}/${encodeURIComponent(work)}` },
          { name: streamHierarchy?.chapter?.title || displayTitle || "Chapter", url: chapterUrl },
        ],
      }}
    />
    <StructuredData
      type="CollectionPage"
      data={{
        name: `${streamHierarchy?.chapter?.title || displayTitle || "Chapter"} · ${streamHierarchy?.work?.title || workName}`,
        description: chapterDescription,
        url: chapterUrl,
        inLanguage: "awa",
      }}
    />
    {chapterItems.length > 0 && (
      <StructuredData
        type="ItemList"
        data={{
          name: `${streamHierarchy?.chapter?.title || displayTitle || "Chapter"} verses`,
          numberOfItems: total,
          items: chapterItems.slice(0, 20).map((item: any) => ({
            position: item.sequence_no,
            name: String(item.main_text || "").replace(/\s+/g, " ").trim().slice(0, 90),
            url: `${baseUrl}/poetry/${item.id}`,
          })),
        }}
      />
    )}
  </head>

  <nav aria-label="Breadcrumb" class="mb-5 overflow-x-auto rounded-lg border border-slate-800/80 bg-slate-900/35 px-3 py-2">
    <ol class="inline-flex min-w-full items-center gap-2 whitespace-nowrap text-sm text-slate-300">
      <li class="max-w-[9rem] truncate md:max-w-[14rem]"><a class="truncate-soft hover:text-cyan-300" href={`/${encodeURIComponent(author)}`}>{streamHierarchy?.author?.name || authorName}</a></li>
      <li aria-hidden="true">/</li>
      <li class="max-w-[9rem] truncate md:max-w-[16rem]"><a class="truncate-soft hover:text-cyan-300" href={`/${encodeURIComponent(author)}/${encodeURIComponent(work)}`}>{streamHierarchy?.work?.title || workName}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="max-w-[9.5rem] truncate text-slate-100 md:max-w-[20rem]">{streamHierarchy?.chapter?.title || displayTitle}</li>
    </ol>
  </nav>

  {pageError && (
    <div class="rounded-lg border border-amber-400/35 bg-amber-500/10 p-4 mb-5">
      <p class="text-sm text-amber-100">{pageError}</p>
    </div>
  )}

  {isEmptyChapter && (
    <div class="glass-panel p-6 md:p-7">
      <h1 class="text-3xl font-serif text-slate-100 mb-3">{displayTitle}</h1>
      <p class="text-slate-300 mb-5">There is no content in this chapter yet. You can check other chapters or return to the work page.</p>
      <div class="flex flex-wrap gap-4">
        <a href={`/${encodeURIComponent(author)}/${encodeURIComponent(work)}`} class="text-cyan-300 hover:text-cyan-200">Back to {safeDecode(work).replace(/-/g," ")}</a>
        <a href={`/${encodeURIComponent(author)}`} class="text-slate-300 hover:text-slate-100">All works by {safeDecode(author)}</a>
      </div>
    </div>
  )}

  {!isEmptyChapter && chapterItems.length > 0 && (
    <section class="glass-panel p-4 md:p-6">
      <h1 class="text-3xl font-serif text-slate-100 mb-2">{streamHierarchy?.chapter?.title || displayTitle}</h1>
      <p class="text-sm text-slate-400 mb-4">Total items: {total}</p>
      {chapterId && (
        <PoetryChapterReader
        client:load
        chapterId={chapterId}
        hierarchy={streamHierarchy}
        items={chapterItems}
        total={total}
        initialLimit={SSR_STREAM_LIMIT}
      />
      )}

      <div class="mt-6">
        <a href={`/${encodeURIComponent(author)}/${encodeURIComponent(work)}`} class="text-cyan-300 hover:text-cyan-200">← Back to {safeDecode(work).replace(/-/g, " ")}</a>
      </div>
    </section>
  )}
</BaseLayout>
