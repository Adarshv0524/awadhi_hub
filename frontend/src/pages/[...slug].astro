---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { api, ApiError } from "../lib/api";
import Breadcrumbs from "../components/content/Breadcrumbs.svelte";

const { slug } = Astro.params;
const segments = Array.isArray(slug) ? slug : [slug || ""];
const n = segments.length;

// top-level content namespaces that map to canonical content/by-path
const CONTENT_NAMESPACES = new Set(["dictionary", "idioms", "articles", "doha", "content"]);

const joinPath = (parts: string[]) => parts.filter(Boolean).join("/");
const slugPath = joinPath(segments);

let data: any = null;
let error: string | null = null;
let pageTitle = "Awadhi New";
let canonicalUrl = `https://awadhi.new/${slugPath}`;
const first = segments[0];
const isNamespaceContent = CONTENT_NAMESPACES.has(first) && n >= 2;
const isDeepCanonical = !isNamespaceContent && n >= 4;
const showCanonicalContent = isNamespaceContent || isDeepCanonical;

try {
  if (n === 0 || (n === 1 && segments[0] === "")) {
    throw new ApiError(404, "Not found");
  }

  // 1) If the URL starts with a top-level content namespace, use content/by-path
  if (CONTENT_NAMESPACES.has(first) && n >= 2) {
    const hierarchyPath = joinPath(segments);
    data = await api(`/content/by-path/${hierarchyPath}`);
    const titleCandidate = data?.title || data?.main_text || data?.text_devanagari || segments.join(" · ");
    pageTitle = `${titleCandidate} · Awadhi New`;
    canonicalUrl = `https://awadhi.new/${hierarchyPath}`;
  } else if (n === 1) {
    // Author page
    const authorSlug = segments[0];
    const author: any = await api(`/authors/${authorSlug}`);
    const works = await api(`/authors/${authorSlug}/works`);
    const dohas: any = await api(`/search?author=${authorSlug}`);
    data = { ...author, __works: works, __dohas: dohas.results };
    pageTitle = `${data?.name ?? authorSlug} · Awadhi New`;
  } else if (n === 2) {
    // Works list for author
    const [authorSlug] = segments;
    data = await api(`/authors/${authorSlug}/works`);
    pageTitle = `${authorSlug} · Works · Awadhi New`;
  } else if (n === 3) {
    // Chapters list for work
    const [authorSlug, workSlug] = segments;
    data = await api(`/authors/${authorSlug}/works/${workSlug}/chapters`);
    pageTitle = `${workSlug} · Chapters · Awadhi New`;
  } else {
    // Fallback: 4+ segments — treat as canonical path
    const hierarchyPath = joinPath(segments);
    data = await api(`/content/by-path/${hierarchyPath}`);
    const titleCandidate = data?.title || data?.main_text || data?.text_devanagari || segments.join(" · ");
    pageTitle = `${titleCandidate} · Awadhi New`;
    canonicalUrl = `https://awadhi.new/${hierarchyPath}`;
  }
} catch (e) {
  if (e instanceof ApiError && e.status === 404) {
    return Astro.redirect("/404");
  }
  error = "Content unavailable at the moment.";
  if (import.meta.env.DEV) {
    console.error("content route error:", e);
  }
}

type DohaSearchResult = {
  id: number;
  main_text: string;
};

const authorDohas: DohaSearchResult[] =
  !error && data && n === 1 && Array.isArray(data.__dohas)
    ? (data.__dohas as DohaSearchResult[])
    : [];
---

<BaseLayout title={pageTitle}>
  <head>
    <link rel="canonical" href={canonicalUrl} />
  </head>

  {!error && slugPath && (
    <div class="mb-4">
      <Breadcrumbs path={slugPath} client:load />
    </div>
  )}

  {error && (
    <div class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-red-200">{error}</div>
  )}

  {/* Author page */}
  {!error && data && n === 1 && (
    <section class="space-y-7">
      <header class="rounded-2xl border border-slate-700 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-6 py-7">
        <h1 class="text-3xl font-serif text-slate-100 mb-2">{data.name}</h1>
        {data.short_bio && (
          <p class="text-sm text-slate-300 max-w-3xl">{data.short_bio}</p>
        )}
      </header>

      <section>
        <h2 class="text-xl font-semibold text-slate-100 mb-3">Works</h2>

      {data.__works && data.__works.length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {data.__works.map((w: any) => (
            <li class="rounded-xl border border-slate-700 bg-slate-900/45 p-4 transition-colors hover:border-cyan-400/40 hover:bg-slate-800/55">
              <a
                href={`/${data.slug}/${w.slug}`}
                class="font-medium text-slate-100 hover:text-cyan-300"
              >
                {w.title}
              </a>
              {w.description && (
                <p class="text-sm text-slate-300 mt-2">{w.description}</p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-slate-400">No works listed.</p>
      )}
      </section>

      <section>
        <h2 class="text-xl font-semibold text-slate-100 mb-3">Dohas</h2>

      {authorDohas.length ? (
        <ul class="space-y-2">
          {authorDohas.map((d) => (
            <li class="rounded-lg border border-slate-700 bg-slate-900/45 px-4 py-3">
              <a href={`/doha/${d.id}`} class="text-slate-100 hover:text-cyan-300">
                {d.main_text.split("॥")[0]}॥
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-slate-400">No dohas found.</p>
      )}
      </section>
    </section>
  )}

  {/* Works list (author) */}
  {!error && data && n === 2 && (
    <section class="rounded-2xl border border-slate-700 bg-slate-900/50 p-5 md:p-6">
      <h1 class="text-3xl font-serif text-slate-100 mb-4">Works</h1>
      {Array.isArray(data) && data.length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {data.map((w: any) => (
            <li class="rounded-xl border border-slate-700 bg-slate-950/45 p-4 transition-colors hover:border-cyan-400/40 hover:bg-slate-800/55">
              <a href={`/${segments[0]}/${w.slug}`} class="font-medium text-slate-100 hover:text-cyan-300">{w.title}</a>
              {w.description && <p class="text-sm text-slate-300 mt-2">{w.description}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-slate-400">No works found for this author.</p>
      )}
    </section>
  )}

  {/* Chapters list */}
  {!error && data && n === 3 && (
    <section class="rounded-2xl border border-slate-700 bg-slate-900/50 p-5 md:p-6">
      <h1 class="text-3xl font-serif text-slate-100 mb-4">Chapters</h1>
      {Array.isArray(data) && data.length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {data.map((c: any) => (
            <li class="rounded-xl border border-slate-700 bg-slate-950/45 p-4 transition-colors hover:border-cyan-400/40 hover:bg-slate-800/55">
              <a href={`/${segments[0]}/${segments[1]}/${c.slug}`} class="font-medium text-slate-100 hover:text-cyan-300">
                {c.title || c.slug}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-slate-400">No chapters found for this work.</p>
      )}
    </section>
  )}

  {/* Canonical content (dictionary/idiom/article/doha or deep path) */}
  {!error && data && showCanonicalContent && (
    <article class="space-y-6 rounded-2xl border border-slate-700 bg-slate-900/55 p-5 md:p-7">
      <header>
        <h1 class="text-3xl font-serif text-slate-100">
          {data.text_devanagari ?? data.title ?? data.main_text ?? segments.join(" · ")}
        </h1>

        {data.text_romanized && <p class="italic text-slate-300 mt-2">{data.text_romanized}</p>}
      </header>

      {data.meaning && (
        <section class="rounded-xl border border-slate-700 bg-slate-950/50 p-4">
          <h2 class="font-semibold text-slate-100 mb-1">Meaning</h2>
          <p class="text-slate-300">{data.meaning}</p>
        </section>
      )}

      <footer class="text-sm text-slate-400 border-t border-slate-700 pt-4">
        {typeof data.version !== "undefined" && <p>Version: {data.version}</p>}
        {data.status && <p>Status: {data.status}</p>}
      </footer>
    </article>
  )}
</BaseLayout>