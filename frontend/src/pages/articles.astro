---
import BaseLayout from "../layouts/BaseLayout.astro";
import { api } from "../lib/api";
import ArticleDiscoverySidebar from "../components/articles/ArticleDiscoverySidebar.svelte";

type Article = {
  id: number;
  title: string;
  summary?: string | null;
};

let articles: Article[] = [];
let error: string | null = null;

try {
  articles = await api<Article[]>("/articles");
} catch (e) {
  error = "Unable to load articles.";
  if (import.meta.env.DEV) console.error(e);
}
---

<BaseLayout
  title="Articles · Awadhi New"
  description="Read research-driven articles on Awadhi language, literature, poetics, and cultural history curated by the Awadhi New editorial team."
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr),minmax(320px,1fr)]">
    <section>
      <h1 class="text-2xl font-serif mb-6">Articles</h1>

      {error && <p class="text-red-600">{error}</p>}

      {!error && (
        <ul class="space-y-4">
          {articles.map((article) => (
            <li class="rounded-xl border border-slate-700 bg-slate-900/45 p-4">
              <a
                href={`/articles/${article.id}`}
                class="text-lg font-semibold text-slate-100 hover:text-cyan-300"
              >
                {article.title}
              </a>

              {article.summary && (
                <p class="mt-2 text-sm text-slate-300">{article.summary}</p>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <ArticleDiscoverySidebar client:load />
  </div>
</BaseLayout>
