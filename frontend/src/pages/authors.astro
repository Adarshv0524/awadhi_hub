---
// src/pages/authors.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthorWorkLiveSearch from "../components/authors/AuthorWorkLiveSearch.svelte";
import { api, ApiError } from "../lib/api";

type Author = {
  id: number;
  slug: string;
  name: string;
  short_bio?: string | null;
  language?: string | null;
};

let authors: Author[] = [];
let error: string | null = null;

try {
  authors = await api<Author[]>("/authors?limit=100");
} catch (e) {
  error = "Unable to load authors at the moment.";
  if (e instanceof ApiError && e.status >= 500 && import.meta.env.DEV) {
    console.error("authors fetch error:", e.payload ?? e.message);
  }
}
---

<BaseLayout
  title="Authors · Awadhi New"
  description="Browse Awadhi authors, poets, and contributors with access to their works, chapters, and related poetry collections."
>
  <section class="relative overflow-hidden rounded-2xl border border-slate-700 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-6 py-8 md:px-8 md:py-10 mb-8">
    <div class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-cyan-400/10 blur-2xl" aria-hidden="true"></div>
    <p class="text-xs uppercase tracking-[0.22em] text-slate-400 mb-3">Literary Archive</p>
    <h1 class="text-3xl md:text-4xl font-serif font-bold bg-gradient-to-r from-cyan-300 via-blue-300 to-indigo-300 bg-clip-text text-transparent mb-3">
      Authors
    </h1>
    <p class="text-slate-300 max-w-2xl">
      Explore major Awadhi poets and writers. Open any profile to browse works, chapters, and related dohas.
    </p>
  </section>

  {error && (
    <div class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-red-200">
      {error}
    </div>
  )}

  {!error && <AuthorWorkLiveSearch client:load initialAuthors={authors} />}
</BaseLayout>
