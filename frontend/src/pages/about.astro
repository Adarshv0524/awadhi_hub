---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About · Awadhi New"
  description="Learn about Awadhi New, a scholarly initiative to preserve and present Awadhi language literature with reliable editorial standards."
>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-serif font-bold text-slate-100 mb-6">About Awadhi New</h1>

    <div class="prose prose-invert max-w-none">
      <p class="text-lg text-slate-300 leading-relaxed mb-4">
        Awadhi New is a scholarly platform focused on preserving,
        structuring, and presenting classical Awadhi content
        with accuracy and respect for source traditions.
      </p>
      
      <div class="mt-8 p-6 bg-slate-800/50 border border-slate-700 rounded-lg">
        <h2 class="text-xl font-semibold text-cyan-400 mb-3">Our Mission</h2>
        <p class="text-slate-300 leading-relaxed">
          To create a comprehensive digital repository that makes Awadhi literature
          accessible to scholars, students, and enthusiasts worldwide while maintaining
          the highest standards of academic rigor.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
