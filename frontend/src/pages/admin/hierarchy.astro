---
// src/pages/admin/hierarchy.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import HierarchyEditor from "../../components/admin/HierarchyEditor.svelte";
export const prerender = false;
const API_BASE = import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : "");
---
<AdminLayout title="Hierarchy · Admin">
  <h1 class="admin-page-title">Content Hierarchy</h1>
  <HierarchyEditor apiBase={API_BASE} client:load />
</AdminLayout>
