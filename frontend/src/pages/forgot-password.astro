---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = false;
---

<BaseLayout title="Forgot Password · Awadhi New" noindex>
  <meta name="robots" content="noindex,nofollow" />

  <section class="max-w-md mx-auto mt-12 px-4">
    <h1 class="text-2xl font-serif mb-2">Forgot Password</h1>
    <p class="text-slate-400 mb-6 text-sm">
      Enter your email and we will send you a password reset link.
    </p>

    <form id="forgotForm" class="space-y-4" method="POST" action="javascript:void(0)" novalidate>
      <div>
        <label class="block text-sm mb-1">Email</label>
        <input
          name="email"
          type="email"
          required
          class="w-full border px-3 py-2 rounded bg-gray-800 text-white"
          placeholder="you@example.com"
        />
      </div>

      <button id="submitBtn" type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        <span id="btnText">Send reset link</span>
        <span id="btnLoading" class="hidden">Sending...</span>
      </button>

      <p id="error" class="text-red-500 text-sm hidden"></p>
      <p id="success" class="text-emerald-400 text-sm hidden"></p>

      <p class="text-sm text-gray-400 text-center">
        Remembered your password?
        <a href="/login" class="text-blue-400 hover:underline">Back to login</a>
      </p>
    </form>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("forgotForm") as HTMLFormElement | null;
      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
      const btnText = document.getElementById("btnText") as HTMLSpanElement | null;
      const btnLoading = document.getElementById("btnLoading") as HTMLSpanElement | null;
      const errorEl = document.getElementById("error") as HTMLParagraphElement | null;
      const successEl = document.getElementById("success") as HTMLParagraphElement | null;

      if (!form || !submitBtn || !btnText || !btnLoading || !errorEl || !successEl) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");
        successEl.classList.add("hidden");
        errorEl.textContent = "";
        successEl.textContent = "";

        submitBtn.disabled = true;
        btnText.classList.add("hidden");
        btnLoading.classList.remove("hidden");

        try {
          const emailInput = form.querySelector('[name="email"]') as HTMLInputElement | null;
          const email = emailInput?.value?.trim() || "";
          if (!email) {
            throw new Error("Email is required");
          }

          const API_BASE = import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : "");
          const res = await fetch(API_BASE + "/auth/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });

          const payload = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(payload?.detail || "Unable to process request");
          }

          successEl.textContent = payload?.message || "If an account exists for this email, a reset link has been sent.";
          successEl.classList.remove("hidden");
          form.reset();
        } catch (err: any) {
          errorEl.textContent = err?.message || "Unable to send reset link";
          errorEl.classList.remove("hidden");
        } finally {
          submitBtn.disabled = false;
          btnText.classList.remove("hidden");
          btnLoading.classList.add("hidden");
        }
      });
    });
  </script>
</BaseLayout>
