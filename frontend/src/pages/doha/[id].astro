---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { api } from "../../lib/api";
import Recommendations from "../../components/recommendations/Recommendations.svelte";
import ContentHistory from "../../components/content/ContentHistory.svelte";
import InteractionBar from "../../components/interaction/InteractionBar.svelte";
import CopyButton from "../../components/content/CopyButton.svelte";
import StructuredData from "../../components/StructuredData.astro";
import TrustSignals from "../../components/content/TrustSignals.svelte";
import ModerationInfo from "../../components/content/ModerationInfo.svelte";
import Breadcrumbs from "../../components/content/Breadcrumbs.svelte";
import { formatHierarchyPath } from "../../lib/hierarchyParser";

const { id } = Astro.params;

let doha;
try {
  doha = await api(`/content/doha/${id}`);
} catch (e) {
  console.error("[Doha] Failed to load", e);
  return Astro.redirect("/404");
}

const baseUrl = import.meta.env.SITE || "https://awadhi.new";
const dohaUrl = `${baseUrl}/doha/${id}`;

// ✅ DEFENSIVE: Format hierarchy path for display
const hierarchyDisplay = formatHierarchyPath(doha.hierarchy_path);

// ✅ DEFENSIVE: Ensure engagement metrics have fallback values
const safeEngagement = {
  likes_count: doha.likes_count ?? 0,
  views_count: doha.views_count ?? 0,
  shares_count: doha.shares_count ?? 0,
  bookmarks_count: doha.bookmarks_count ?? 0,
};

// ✅ DEFENSIVE: Author/work names fallback
const authorDisplay = doha.author_name || (doha.author_id ? `Author #${doha.author_id}` : 'Unknown Author');
const workDisplay = doha.work_name || (doha.work_id ? `Work #${doha.work_id}` : null);
---

<BaseLayout title={`${doha.main_text} · Awadhi New`}>
  <head>
    <!-- Structured Data for Doha (Creative Work) -->
    <StructuredData 
      type="CreativeWork" 
      data={{
        text: doha.main_text,
        meaning: doha.meaning,
        datePublished: doha.created_at ?? undefined,
        author: authorDisplay,
        work: workDisplay
      }} 
    />
    
    <!-- Breadcrumb Structured Data -->
    <StructuredData 
      type="BreadcrumbList"
      data={{
        items: [
          { name: "Home", url: baseUrl },
          { name: "Doha", url: `${baseUrl}/doha` },
          { name: `#${doha.id}`, url: dohaUrl }
        ]
      }}
    />
  </head>
  
  <div class="max-w-3xl mx-auto px-4 py-8">
    <!-- ✅ BREADCRUMBS: Show hierarchy path if available -->
    {doha.hierarchy_path && (
      <div class="mb-6">
        <Breadcrumbs path={doha.hierarchy_path} client:load />
      </div>
    )}

    <!-- Fallback breadcrumbs if no hierarchy -->
    {!doha.hierarchy_path && (
      <nav class="text-sm text-slate-500 mb-6">
        <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
        <span class="mx-2">›</span>
        <a href="/doha" class="hover:text-cyan-400 transition-colors">Doha</a>
        <span class="mx-2">›</span>
        <span class="text-slate-400">#{doha.id}</span>
      </nav>
    )}

    <article class="space-y-8">
      <!-- Trust Signals -->
      <div class="flex justify-center">
        <TrustSignals 
          client:load
          isCanonical={doha.is_canonical ?? false}
          confidenceLevel={doha.confidence_level ?? 0}
          sourceReference={doha.source_reference ?? undefined}
          verifiedBy={doha.verified_by ?? undefined}
          verifiedAt={doha.verified_at ?? undefined}
        />
      </div>

      <!-- Main Content -->
      <div>
        <h1 class="text-3xl md:text-4xl font-serif leading-relaxed text-center text-slate-100 mb-4 break-words">
          {doha.main_text}
        </h1>
        
        <!-- ✅ DEFENSIVE: Show hierarchy path formatted -->
        {hierarchyDisplay && (
          <p class="text-sm text-gray-400 text-center mb-2 truncate px-4" title={hierarchyDisplay}>
            {hierarchyDisplay}
          </p>
        )}
        
        <!-- Copy button -->
        <div class="flex justify-center">
          <CopyButton text={doha.main_text} label="Text" color="cyan" client:load />
        </div>
      </div>

      {doha.meaning && (
        <p class="text-lg text-slate-300 leading-relaxed text-center max-w-2xl mx-auto break-words">
          {doha.meaning}
        </p>
      )}

      <!-- Moderation Info -->
      <ModerationInfo 
        client:load
        createdAt={doha.created_at ?? undefined}
        updatedAt={doha.updated_at ?? undefined}
        version={doha.version || 1}
        hasVersionHistory={(doha.version || 1) > 1}
        contentType="doha"
        contentId={doha.id}
      />

      <!-- ✅ DEFENSIVE: Interaction bar with safe engagement data -->
      <div class="py-6 border-t border-b border-slate-700 flex justify-center">
        <InteractionBar
          client:only="svelte"
          contentType="doha"
          contentId={doha.id}
          likes={safeEngagement.likes_count}
          bookmarks={safeEngagement.bookmarks_count}
          shares={safeEngagement.shares_count}
        />
      </div>

    <!-- ✅ ALWAYS RENDER -->
    <Recommendations
      content_type="doha"
      content_id={doha.id}
      client:load
    />

    <!-- Content history (Doha only) -->
    <ContentHistory dohaId={doha.id} client:load />

    <div class="text-center pt-4">
      <a href="/doha" class="text-cyan-400 hover:text-cyan-300 underline">← Back to Doha</a>
    </div>
  </article>
  </div>
</BaseLayout>
