---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = false;
---

<BaseLayout title="Register · Awadhi New">
  <meta name="robots" content="noindex,nofollow" />

  <div class="max-w-md mx-auto mt-12 px-4">
    <h1 class="text-2xl font-serif mb-6">Create Account</h1>
    
    <form id="registerForm" class="space-y-4" method="POST" action="javascript:void(0)" novalidate>
      <div>
        <label class="block text-sm mb-1">Username (optional)</label>
        <input name="username" type="text" class="w-full border px-3 py-2 rounded bg-gray-800 text-white" placeholder="Leave blank for email-based username" />
      </div>
      
      <div>
        <label class="block text-sm mb-1">Email</label>
        <input name="email" type="email" required class="w-full border px-3 py-2 rounded bg-gray-800 text-white" />
      </div>
      
      <div>
        <label class="block text-sm mb-1">Password</label>
        <input name="password" type="password" required minlength="6" class="w-full border px-3 py-2 rounded bg-gray-800 text-white" />
        <p class="text-xs text-gray-400 mt-1">Minimum 6 characters</p>
      </div>

      <button id="submitBtn" type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        <span id="btnText">Register</span>
        <span id="btnLoading" class="hidden">Creating account...</span>
      </button>
      <p id="error" class="text-red-600 text-sm hidden"></p>
      <p id="success" class="text-green-600 text-sm hidden"></p>
      
      <p class="text-sm text-gray-400 text-center">
        Already have an account?
        <a href="/login" class="text-blue-500 hover:underline">Sign in</a>
      </p>
    </form>

    <form id="verifyForm" class="space-y-4 hidden mt-6" method="POST" action="javascript:void(0)" novalidate>
      <p class="text-sm text-gray-300">We sent a 6-digit OTP to <span id="verifyEmail" class="font-semibold"></span>.</p>
      <div>
        <label class="block text-sm mb-1">Email OTP</label>
        <input id="otpInput" name="otp" type="text" inputmode="numeric" maxlength="6" required class="w-full border px-3 py-2 rounded bg-gray-800 text-white" placeholder="Enter 6-digit code" />
      </div>
      <button id="verifyBtn" type="submit" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Verify Email
      </button>
      <button id="resendBtn" type="button" class="w-full bg-gray-700 text-white py-2 rounded hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Resend OTP
      </button>
      <p id="verifyError" class="text-red-600 text-sm hidden"></p>
      <p id="verifySuccess" class="text-green-600 text-sm hidden"></p>
    </form>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById("registerForm") as HTMLFormElement | null;
      const errorEl = document.getElementById("error") as HTMLParagraphElement | null;
      const successEl = document.getElementById("success") as HTMLParagraphElement | null;
      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
      const btnText = document.getElementById("btnText") as HTMLSpanElement | null;
      const btnLoading = document.getElementById("btnLoading") as HTMLSpanElement | null;
      const verifyForm = document.getElementById("verifyForm") as HTMLFormElement | null;
      const verifyEmailEl = document.getElementById("verifyEmail") as HTMLSpanElement | null;
      const otpInput = document.getElementById("otpInput") as HTMLInputElement | null;
      const verifyBtn = document.getElementById("verifyBtn") as HTMLButtonElement | null;
      const resendBtn = document.getElementById("resendBtn") as HTMLButtonElement | null;
      const verifyError = document.getElementById("verifyError") as HTMLParagraphElement | null;
      const verifySuccess = document.getElementById("verifySuccess") as HTMLParagraphElement | null;

      let registeredUserId: number | null = null;
      let registeredEmail = "";

      if (!form || !errorEl || !successEl || !submitBtn || !btnText || !btnLoading || !verifyForm || !verifyEmailEl || !otpInput || !verifyBtn || !resendBtn || !verifyError || !verifySuccess) {
        console.error('[register] Form elements not found');
        return;
      }

      console.log('[register] Form initialized, attaching submit handler');

      form.addEventListener("submit", async (e) => {
        console.log('[register] Form submitted!');
        e.preventDefault();
        e.stopPropagation();
        
        errorEl.classList.add("hidden");
        errorEl.textContent = "";
        successEl.classList.add("hidden");
        successEl.textContent = "";

        // Show loading state
        submitBtn.disabled = true;
        btnText.classList.add("hidden");
        btnLoading.classList.remove("hidden");

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries()) as Record<string, FormDataEntryValue>;
        
        // Remove empty username
        if (!data.username || String(data.username).trim() === '') {
          delete data.username;
        }

        try {
          const API_BASE = import.meta.env.PUBLIC_API_BASE || "http://localhost:8000";
          
          const res = await fetch(API_BASE + "/auth/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });

          const json = await res.json();
          
          if (!res.ok) {
            if (res.status === 422 && Array.isArray(json.detail)) {
              const msg = json.detail
                .map((d: any) => (d?.loc ? `${d.loc.join(".")}: ${d.msg}` : d?.msg || "Validation error"))
                .join(", ");
              throw new Error(msg || "Validation failed");
            }
            throw new Error(json.detail || json.message || "Registration failed");
          }

          if (json.access_token) {
            localStorage.setItem("awadhi_access_token", json.access_token);
          }
          if (json.refresh_token) {
            localStorage.setItem("awadhi_refresh_token", json.refresh_token);
          }

          if (json.access_token) {
            try {
              const meRes = await fetch(API_BASE + "/auth/me", {
                headers: { Authorization: `Bearer ${json.access_token}` },
              });
              if (meRes.ok) {
                const me = await meRes.json();
                localStorage.setItem("awadhi_user_cache", JSON.stringify(me));
              }
            } catch (_err) {
              // non-blocking
            }
          }

          registeredUserId = Number(json.id);
          registeredEmail = String(json.email || data.email || "");
          verifyEmailEl.textContent = registeredEmail;

          successEl.textContent = `Account created successfully! Welcome, ${json.username || 'user'}.`;
          successEl.classList.remove("hidden");

          form.classList.add("hidden");
          verifyForm.classList.remove("hidden");
        } catch (err: any) {
          console.error('[register] Error:', err);
          errorEl.textContent = err?.message || "Registration failed";
          errorEl.classList.remove("hidden");
        } finally {
          // Reset button state
          submitBtn.disabled = false;
          btnText.classList.remove("hidden");
          btnLoading.classList.add("hidden");
        }
        
        return false;
      });

      verifyForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        verifyError.classList.add("hidden");
        verifySuccess.classList.add("hidden");

        if (!registeredUserId || !registeredEmail) {
          verifyError.textContent = "Missing registration context. Please register again.";
          verifyError.classList.remove("hidden");
          return;
        }

        const otp = otpInput.value.trim();
        if (!otp || otp.length !== 6) {
          verifyError.textContent = "Please enter a valid 6-digit OTP.";
          verifyError.classList.remove("hidden");
          return;
        }

        verifyBtn.disabled = true;
        try {
          const API_BASE = import.meta.env.PUBLIC_API_BASE || "http://localhost:8000";
          const res = await fetch(API_BASE + "/auth/verify-email", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ user_id: registeredUserId, email: registeredEmail, otp }),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(payload?.detail || payload?.message || "OTP verification failed");
          }
          verifySuccess.textContent = payload?.message || "Email verified successfully.";
          verifySuccess.classList.remove("hidden");
          setTimeout(() => {
            window.location.href = "/dashboard";
          }, 1000);
        } catch (err: any) {
          verifyError.textContent = err?.message || "OTP verification failed";
          verifyError.classList.remove("hidden");
        } finally {
          verifyBtn.disabled = false;
        }
      });

      resendBtn.addEventListener("click", async () => {
        verifyError.classList.add("hidden");
        verifySuccess.classList.add("hidden");

        if (!registeredUserId || !registeredEmail) {
          verifyError.textContent = "Missing registration context. Please register again.";
          verifyError.classList.remove("hidden");
          return;
        }

        resendBtn.disabled = true;
        try {
          const API_BASE = import.meta.env.PUBLIC_API_BASE || "http://localhost:8000";
          const res = await fetch(API_BASE + "/auth/resend-email-otp", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ user_id: registeredUserId, email: registeredEmail }),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(payload?.detail || payload?.message || "Failed to resend OTP");
          }
          verifySuccess.textContent = payload?.message || "Verification OTP sent.";
          verifySuccess.classList.remove("hidden");
        } catch (err: any) {
          verifyError.textContent = err?.message || "Failed to resend OTP";
          verifyError.classList.remove("hidden");
        } finally {
          resendBtn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>
