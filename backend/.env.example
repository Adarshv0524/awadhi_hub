# Backend Environment Variables Template
# Copy this to .env and fill in your values

# Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=awadhi_db

# Application Environment
APP_ENV=production
APP_DEBUG=false

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=1209600
PASSWORD_RESET_TOKEN_EXPIRES_SECONDS=3600

# Frontend URL used in password reset links
FRONTEND_BASE_URL=http://localhost:4321

# SMTP Email (for forgot password)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Development callback (must match Google Console OAuth redirect URI)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
# Production callback example:
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/oauth/google/callback

# Production CORS (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
