---
// src/pages/admin/index.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import SystemStatus from "../../components/admin/SystemStatus.svelte";
import SummaryKpiCards from "../../components/admin/SummaryKpiCards.svelte";
import AdminSloPanel from "../../components/admin/AdminSloPanel.svelte";
import AdminMissionControl from "../../components/admin/AdminMissionControl.svelte";
export const prerender = false;
const API_BASE = import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : "");
---
<AdminLayout title="Admin · Awadhi New">
  <section class="mb-6 rounded-2xl border border-slate-700/70 bg-slate-900/50 p-5 md:p-7">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-300/90">Operations Nerve Center</p>
    <h1 class="admin-page-title mb-2">Admin Mission Deck</h1>
    <p class="admin-page-subtitle mb-0">Run moderation, governance, and platform intelligence from a single high-signal cockpit.</p>
  </section>

  <div class="mb-6">
    <SummaryKpiCards title="Global Platform Summary" useAdminSummary={true} client:load />
  </div>

  <div class="mb-6">
    <AdminMissionControl client:load />
  </div>

  <div class="mb-6">
    <h2 class="admin-page-title">System Integrity</h2>
    <p class="admin-page-subtitle mb-3">Realtime endpoint health and auth-aware access diagnostics for critical control-plane routes.</p>
    <SystemStatus apiBase={API_BASE} client:load />
  </div>

  <div class="mb-6">
    <AdminSloPanel client:load />
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <div class="admin-panel p-4 transition-colors">
      <h2 class="font-semibold text-lg">Users Command</h2>
      <p class="text-sm text-slate-300 mt-2">Role governance, permission boundaries, and account state controls with strict admin authorization.</p>
      <div class="mt-4">
        <a class="admin-btn admin-btn-primary inline-block" href="/admin/users">Manage Users →</a>
      </div>
    </div>

    <div class="admin-panel p-4 transition-colors">
      <h2 class="font-semibold text-lg">Knowledge Graph</h2>
      <p class="text-sm text-slate-300 mt-2">Curate Authors → Works → Chapters as a structured corpus graph for retrieval, enrichment, and AI indexing.</p>
      <div class="mt-4">
        <a class="admin-btn admin-btn-primary inline-block" href="/admin/hierarchy">Manage Hierarchy →</a>
      </div>
    </div>

    <div class="admin-panel p-4 transition-colors">
      <h2 class="font-semibold text-lg">Audit Ledger</h2>
      <p class="text-sm text-slate-300 mt-2">Immutable action chronology with policy-safe visibility and PII-minimized payload introspection.</p>
      <div class="mt-4">
        <a class="admin-btn admin-btn-primary inline-block" href="/admin/audit">View Logs →</a>
      </div>
    </div>

    <div class="admin-panel p-4 transition-colors">
      <h2 class="font-semibold text-lg">Control Policies</h2>
      <p class="text-sm text-slate-300 mt-2">Manage safety and runtime settings with blast-radius awareness and production-safe update workflows.</p>
      <div class="mt-4">
        <a class="admin-btn admin-btn-primary inline-block" href="/admin/settings">View Settings →</a>
      </div>
    </div>

    <div class="admin-panel p-4 transition-colors">
      <h2 class="font-semibold text-lg">Moderation Operations</h2>
      <p class="text-sm text-slate-300 mt-2">Human-in-the-loop moderation queue with AI triage hints, confidence rationale, and explicit approval controls.</p>
      <div class="mt-4">
        <a class="admin-btn inline-block" href="/moderation">Go to Queue →</a>
      </div>
    </div>

    <div class="admin-panel p-4 transition-colors">
      <h2 class="font-semibold text-lg">Investigations Lab</h2>
      <p class="text-sm text-slate-300 mt-2">Operational telemetry, anomaly signatures, and 3D investigative analytics for deep causality analysis.</p>
      <div class="mt-4">
        <a class="admin-btn admin-btn-primary inline-block" href="/admin/analytics">View Analytics →</a>
      </div>
    </div>
  </div>
</AdminLayout>
