---
// src/pages/submissions/[id].astro
// Fetch submission client-side to access auth tokens
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import SubmissionDetail from "../../components/submission/SubmissionDetail.svelte";

const { id } = Astro.params;

const title = `Submission #${id} · Awadhi New`;
---

<BaseLayout title={title}>
  <head>
    <meta name="robots" content="noindex,nofollow" />
  </head>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-slate-400 mb-6">
      <a href="/" class="hover:text-cyan-400">Home</a> › 
      <a href="/submissions" class="hover:text-cyan-400">My Submissions</a> › 
      <span class="text-slate-300">#{id}</span>
    </nav>

    <!-- Fetch client-side to access localStorage auth token -->
    <SubmissionDetail client:only="svelte" submissionId={id} />
  </div>
</BaseLayout>
