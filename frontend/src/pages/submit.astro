---
// src/pages/submit.astro
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionForm from "../components/submission/SubmissionFormRedesigned.svelte";
import AuthGuard from "../components/auth/AuthGuard.astro";

const API_BASE = import.meta.env.PUBLIC_API_BASE || (import.meta.env.DEV ? "http://localhost:8000" : "");
---

<BaseLayout title="Submit Content · Awadhi New">
  <meta name="robots" content="noindex,nofollow" />
  <AuthGuard minRole="registered" apiBase={API_BASE} />
  
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <!-- Header Section -->
    <div class="mb-4 sm:mb-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-serif font-bold bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent mb-2 sm:mb-3">
        Contribute to Awadhi New
      </h1>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto">
        Share your knowledge of Awadhi language and culture. Submit poetry, dictionary entries, idioms, or articles.
      </p>
    </div>

    <!-- Submission Form -->
    <div class="bg-slate-900 border border-slate-700 rounded-xl p-3 sm:p-6 shadow-2xl">
      <SubmissionForm client:load apiBase={API_BASE} />
    </div>

    <!-- Guidelines -->
    <details class="mt-4 sm:mt-8 bg-blue-900/20 border border-blue-800/30 rounded-lg p-4 sm:p-5">
      <summary class="font-semibold text-blue-300 cursor-pointer list-none flex items-center gap-2 select-none">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
          <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
        </svg>
        Submission Guidelines
      </summary>
      <ul class="text-sm text-blue-200 space-y-2 mt-3">
        <li class="flex items-start gap-2">
          <span class="text-blue-400 mt-1">•</span>
          <span>Ensure accuracy: Double-check spellings, meanings, and attributions</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-400 mt-1">•</span>
          <span>Provide context: Add meanings, translations, and usage examples where relevant</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-400 mt-1">•</span>
          <span>Respect copyright: Only submit original work or content in the public domain</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-400 mt-1">•</span>
          <span>Review process: All submissions are reviewed by moderators before publication</span>
        </li>
      </ul>
    </details>
  </div>
</BaseLayout>
