---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { api } from "../../lib/api";
import Breadcrumbs from "../../components/content/Breadcrumbs.svelte";

const { author, work } = Astro.params;

const safeDecode = (s: any) => {
  try {
    return decodeURIComponent(s);
  } catch {
    return s;
  }
};

const authorSlug = encodeURIComponent(String(author ?? ""));
const workSlug = encodeURIComponent(String(work ?? ""));

let chapters = [];
let workMeta: any = null;
let authorMeta: any = null;
let chapterCount = 0;
let totalPoetryNodes = 0;

try {
  [workMeta, authorMeta] = await Promise.all([
    api(`/authors/${authorSlug}/works/${workSlug}`),
    api(`/authors/${authorSlug}`),
  ]);
} catch {
  workMeta = null;
  authorMeta = null;
}

try {
  chapters = await api(`/authors/${authorSlug}/works/${workSlug}/chapters`);
  chapterCount = Array.isArray(chapters) ? chapters.length : 0;
  totalPoetryNodes = Array.isArray(chapters)
    ? chapters.reduce((acc: number, chapter: any) => acc + Number(chapter?.poetry_nodes_count || 0), 0)
    : 0;
} catch {
  chapters = [];
  chapterCount = 0;
  totalPoetryNodes = 0;
}
---

<BaseLayout title={`${safeDecode(work)} · Awadhi New`}>
  <div class="mb-5">
    <Breadcrumbs path={`${author}/${work}`} client:load />
  </div>

  <section class="rounded-2xl border border-slate-700 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-6 py-7 mb-7">
    <p class="text-xs uppercase tracking-[0.2em] text-slate-400 mb-2">Work Landing</p>
    <h1 class="text-3xl font-serif font-bold text-slate-100 mb-2 break-words">
      {workMeta?.title || safeDecode(work).replace(/-/g, " ")}
    </h1>

    <p class="text-slate-300 text-sm">
      {workMeta?.description || "Browse all available chapters in this work."}
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-cyan-700/40 bg-cyan-950/20 p-3">
        <p class="text-[11px] uppercase tracking-wide text-cyan-300">Author</p>
        <p class="mt-1 text-sm font-semibold text-cyan-100">{authorMeta?.name || safeDecode(author)}</p>
      </div>
      <div class="rounded-lg border border-purple-700/40 bg-purple-950/20 p-3">
        <p class="text-[11px] uppercase tracking-wide text-purple-300">Chapters</p>
        <p class="mt-1 text-sm font-semibold text-purple-100">{chapterCount}</p>
      </div>
      <div class="rounded-lg border border-emerald-700/40 bg-emerald-950/20 p-3">
        <p class="text-[11px] uppercase tracking-wide text-emerald-300">Poetry Nodes</p>
        <p class="mt-1 text-sm font-semibold text-emerald-100">{totalPoetryNodes}</p>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-400">
      {workMeta?.work_type && <span class="rounded border border-slate-600 px-2 py-1">Type: {workMeta.work_type}</span>}
      {workMeta?.original_script && <span class="rounded border border-slate-600 px-2 py-1">Script: {workMeta.original_script}</span>}
      {authorMeta?.language && <span class="rounded border border-slate-600 px-2 py-1">Language: {authorMeta.language}</span>}
    </div>
  </section>

  {
    chapters.length === 0
      ? (
        <div class="rounded-xl border border-slate-700 bg-slate-900/50 p-5">
          <p class="text-slate-300">
            No chapters are available for this work yet.
          </p>
          <a href={`/${authorSlug}`} class="inline-flex items-center text-cyan-300 hover:text-cyan-200 mt-3">
            ← Back to author
          </a>
        </div>
      )
      : (
        <ul class="grid gap-3 sm:grid-cols-2">
          {(chapters as any[]).map((c) => (
            <li class="rounded-xl border border-slate-700 bg-slate-900/45 p-4 transition-colors hover:border-cyan-400/40 hover:bg-slate-800/55">
              <a
                href={`/${authorSlug}/${workSlug}/${encodeURIComponent(c.slug)}`}
                class="font-medium text-slate-100 hover:text-cyan-300"
              >
                {c.title || c.slug}
              </a>
              <p class="text-xs uppercase tracking-[0.16em] text-slate-400 mt-2">Chapter</p>
              <p class="text-xs text-slate-500 mt-1">Poetry Nodes: {c.poetry_nodes_count ?? 0}</p>
            </li>
          ))}
        </ul>
      )
  }
</BaseLayout>