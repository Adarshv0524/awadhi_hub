---
// src/components/Header.astro
import AuthStatus from "./auth/AuthStatus.svelte";

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---
<header class="border-b border-slate-700 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 shadow-lg">
  <div class="max-w-6xl w-full mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 text-xl font-serif font-bold bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent hover:from-cyan-300 hover:via-blue-300 hover:to-indigo-300 transition-all">
        <img src="/favicon.svg" alt="Awadhi New Logo" class="w-11 h-11" />
        <span>Awadhi New</span>
      </a>
      <nav class="hidden sm:flex items-center gap-4 text-sm">
        <a 
          href="/about" 
          class:list={[
            "transition-colors px-3 py-1.5 rounded",
            isActive('/about') ? "bg-cyan-900/40 text-cyan-200 font-semibold" : "text-cyan-300 hover:text-cyan-100 hover:underline"
          ]}
        >About</a>
        <a 
          href="/search" 
          class:list={[
            "transition-colors px-3 py-1.5 rounded",
            isActive('/search') ? "bg-blue-900/40 text-blue-200 font-semibold" : "text-blue-300 hover:text-blue-100 hover:underline"
          ]}
        >Search</a>
        <a 
          href="/authors" 
          class:list={[
            "transition-colors px-3 py-1.5 rounded",
            isActive('/authors') ? "bg-indigo-900/40 text-indigo-200 font-semibold" : "text-indigo-300 hover:text-indigo-100 hover:underline"
          ]}
        >Authors</a>
        <a 
          href="/submit" 
          class:list={[
            "transition-colors px-3 py-1.5 rounded",
            isActive('/submit') ? "bg-purple-900/40 text-purple-200 font-semibold" : "text-purple-300 hover:text-purple-100 hover:underline"
          ]}
        >Contribute</a>
      </nav>
    </div>

    <!-- AuthStatus handles role-links & user area on the client -->
    <div>
      <AuthStatus client:load />
    </div>
  </div>
</header>
