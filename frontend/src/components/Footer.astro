---
import AuthStatus from "./auth/AuthStatus.svelte";

const currentYear = new Date().getFullYear();
---
<footer class="site-footer mt-8">
  <div class="site-footer-inner">
    <div class="footer-branding">
      <div class="footer-title-row">
        <span class="footer-dot" aria-hidden="true"></span>
        <span class="footer-title">Awadhi New</span>
      </div>
      <p class="footer-copy">Preserving Awadhi language, literature, and cultural memory.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer links">
      <a href="/" class="footer-link">Home</a>
      <a href="/poetry" class="footer-link">Poetry</a>
      <a href="/submit" class="footer-link">Contribute</a>
      <a href="/about" class="footer-link">About</a>
    </nav>

    <div class="footer-meta">
      <div class="footer-year">© {currentYear} Awadhi New</div>
      <div class="footer-role">
        <AuthStatus minimal={true} client:idle />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(148, 163, 184, 0.2);
    background:
      radial-gradient(120% 220% at 100% -40%, rgba(56, 189, 248, 0.14), transparent 50%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.92) 0%, rgba(2, 6, 23, 0.96) 100%);
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.1rem 1rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    gap: 0.9rem 1.25rem;
    align-items: center;
  }

  .footer-branding {
    min-width: 0;
  }

  .footer-title-row {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 0.01em;
  }

  .footer-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #22d3ee 0%, #10b981 100%);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.5);
  }

  .footer-copy {
    margin: 0.3rem 0 0;
    font-size: 0.825rem;
    color: #94a3b8;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    justify-content: center;
  }

  .footer-link {
    color: #cbd5e1;
    font-size: 0.87rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: #67e8f9;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.45rem;
  }

  .footer-year {
    font-size: 0.82rem;
    color: #94a3b8;
    white-space: nowrap;
  }

  .footer-role {
    display: inline-flex;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .site-footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-nav {
      justify-content: center;
    }

    .footer-meta {
      align-items: center;
    }

    .footer-role {
      justify-content: center;
    }
  }
</style>
