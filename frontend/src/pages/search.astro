---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import SearchExperience from "../components/search/SearchExperience.svelte";

const url = new URL(Astro.request.url);
const q = url.searchParams.get("q") || "";
const contentFilter = url.searchParams.get("type") || "all";
const sort = url.searchParams.get("sort") || "relevance";
const author = url.searchParams.get("author") || "";
const work = url.searchParams.get("work") || "";
const poetryType = url.searchParams.get("poetry_type") || "all";

const allowedType = new Set(["all", "poetry", "dictionary", "idiom", "article"]);
const allowedSort = new Set(["relevance", "recent"]);
const safeType = (allowedType.has(contentFilter) ? contentFilter : "all") as "all" | "poetry" | "dictionary" | "idiom" | "article";
const safeSort = (allowedSort.has(sort) ? sort : "relevance") as "relevance" | "recent";
---

<BaseLayout
  title={q ? `Search: ${q}` : "Search"}
  description="Search across Awadhi poetry, dictionary entries, idioms, and articles with filters for content type, author, and relevance."
>
  <SearchExperience
    client:load
    initialQuery={q}
    initialType={safeType}
    initialSort={safeSort}
    initialAuthor={author}
    initialWork={work}
    initialPoetryType={poetryType}
  />
</BaseLayout>
