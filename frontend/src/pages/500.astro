---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Server Error · Awadhi New" noindex>
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="max-w-2xl w-full text-center">
      <!-- Error Code -->
      <div class="mb-8">
        <h1 class="text-9xl font-bold bg-gradient-to-r from-red-400 via-pink-400 to-rose-400 bg-clip-text text-transparent">
          500
        </h1>
        <div class="text-2xl font-serif text-slate-300 mt-4">Server Error</div>
      </div>

      <!-- Message -->
      <div class="mb-8 p-6 bg-slate-800 border border-slate-700 rounded-lg">
        <p class="text-slate-400 text-lg mb-3">
          Something went wrong on our end.
        </p>
        <p class="text-slate-500 text-sm">
          We've been notified and are working to fix the issue. Please try again later.
        </p>
      </div>

      <!-- Status Indicator -->
      <div class="mb-8 p-4 bg-red-900/20 border border-red-700/50 rounded-lg">
        <div class="flex items-center justify-center gap-2 text-red-400">
          <div class="w-2 h-2 bg-red-400 rounded-full animate-pulse"></div>
          <span class="text-sm font-medium">Our team has been alerted</span>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="space-y-4">
        <div class="text-sm text-slate-500 mb-4">What you can try:</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button
            onclick="window.location.reload()"
            class="px-6 py-3 bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white rounded-lg transition-all font-medium shadow-lg"
          >
            🔄 Refresh Page
          </button>
          <a
            href="/"
            class="px-6 py-3 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 rounded-lg transition-colors font-medium"
          >
            🏠 Go Home
          </a>
        </div>
      </div>

      <!-- Help Text -->
      <div class="mt-8 text-sm text-slate-500">
        If the problem persists, please <a href="/about" class="text-rose-400 hover:text-rose-300 underline">contact support</a>.
      </div>
    </div>
  </div>
</BaseLayout>
