---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { api } from "../lib/api";

let featuredArticles = [];
try {
  featuredArticles = await api("/articles?limit=5");
} catch (e) {
  // non-fatal
  featuredArticles = [];
}
---

<BaseLayout title="Awadhi New · Home">
  <!-- Hero Section -->
  <div class="relative -mt-8 -mx-4 mb-12 px-4 py-20 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 border-b border-slate-700">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-serif font-bold mb-6 bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">
        Awadhi New
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 mb-8 leading-relaxed">
        A Scholarly Repository of Awadhi Literature
      </p>
      <p class="text-slate-400 mb-10 max-w-2xl mx-auto">
        Preserving classical Awadhi content with dohas, idioms, dictionary entries, and scholarly articles
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/search" class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white font-semibold rounded-lg shadow-lg transition-all transform hover:scale-105">
          Explore Content
        </a>
        <a href="/submit" class="px-6 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 font-semibold rounded-lg shadow-lg transition-all transform hover:scale-105 border border-slate-600">
          Contribute
        </a>
      </div>
    </div>
  </div>

  <!-- Content Grid -->
  <div class="grid md:grid-cols-3 gap-6 mb-12">
    <!-- Quick Access Cards -->
    <a href="/doha" class="group p-6 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-cyan-500 rounded-lg transition-all transform hover:scale-105">
      <div class="text-3xl mb-3">📜</div>
      <h3 class="text-lg font-semibold text-cyan-400 mb-2">Dohas</h3>
      <p class="text-sm text-slate-400">Traditional Awadhi poetic couplets</p>
    </a>
    
    <a href="/dictionary" class="group p-6 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-blue-500 rounded-lg transition-all transform hover:scale-105">
      <div class="text-3xl mb-3">📖</div>
      <h3 class="text-lg font-semibold text-blue-400 mb-2">Dictionary</h3>
      <p class="text-sm text-slate-400">Comprehensive Awadhi vocabulary</p>
    </a>
    
    <a href="/idioms" class="group p-6 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-indigo-500 rounded-lg transition-all transform hover:scale-105">
      <div class="text-3xl mb-3">💬</div>
      <h3 class="text-lg font-semibold text-indigo-400 mb-2">Idioms</h3>
      <p class="text-sm text-slate-400">Expressions and phrases</p>
    </a>
    
    <a href="/articles" class="group p-6 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-purple-500 rounded-lg transition-all transform hover:scale-105">
      <div class="text-3xl mb-3">📝</div>
      <h3 class="text-lg font-semibold text-purple-400 mb-2">Articles</h3>
      <p class="text-sm text-slate-400">Scholarly research and essays</p>
    </a>
    
    <a href="/authors" class="group p-6 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-pink-500 rounded-lg transition-all transform hover:scale-105">
      <div class="text-3xl mb-3">👥</div>
      <h3 class="text-lg font-semibold text-pink-400 mb-2">Authors</h3>
      <p class="text-sm text-slate-400">Browse by contributors</p>
    </a>
    
    <a href="/search" class="group p-6 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-emerald-500 rounded-lg transition-all transform hover:scale-105">
      <div class="text-3xl mb-3">🔍</div>
      <h3 class="text-lg font-semibold text-emerald-400 mb-2">Search</h3>
      <p class="text-sm text-slate-400">Find content across all types</p>
    </a>
  </div>

  <!-- Featured Articles -->
  {featuredArticles.length > 0 && (
    <section class="bg-slate-800/30 border border-slate-700 rounded-lg p-6">
      <h2 class="text-2xl font-serif font-semibold text-slate-100 mb-6 flex items-center gap-2">
        <span class="text-2xl">⭐</span>
        Featured Articles
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {featuredArticles.map(article => (
          <a 
            href={`/articles/${article.id}`} 
            class="p-4 bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-purple-500 rounded-lg transition-all group"
          >
            <h3 class="font-semibold text-slate-200 group-hover:text-purple-400 transition-colors mb-2">
              {article.title}
            </h3>
            {article.body && (
              <p class="text-sm text-slate-400 line-clamp-2">
                {article.body.slice(0, 120)}...
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
